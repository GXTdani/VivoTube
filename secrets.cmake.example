# Copy to secrets.cmake (ignored by git) to build your own Google OAuth client into VivoTube.
# Use a client of type "TVs and Limited Input devices" (see the README's sign-in section).
# Without this file, the app reads ux0:data/VivoTube/google_client.json at runtime instead.
set(VT_GOOGLE_CLIENT_ID "1234567890-example.apps.googleusercontent.com")
set(VT_GOOGLE_CLIENT_SECRET "GOCSPX-example")
